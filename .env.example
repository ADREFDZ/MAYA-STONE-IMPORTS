# Copia este archivo a .env.local (desarrollo) y configura las mismas
# variables en el panel del hosting (producción). Nunca subas valores reales.

# URL pública del sitio, SIN barra final.
# Desarrollo: http://localhost:3000  |  Producción: https://www.gpomaya.com
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Acceso al login de admin (/login?key=...)
ADMIN_LOGIN_KEY=

# Integraciones
NEXT_PUBLIC_META_PIXEL_ID=
# Instagram (API oficial de Meta). Token de larga duración de tu app en
# Meta Developers. Si empieza con "IG" se renueva solo cada ~50 días.
# Si es un token de Facebook Login ("EAA…"), agrega también INSTAGRAM_USER_ID.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
GEMINI_API_KEY=
MONDAY_API_TOKEN=
MONDAY_LEADS_BOARD_ID=
